{
  "name": "pixel-clock-appium-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile automation tests for Pixel Clock using WebdriverIO, Appium, and TypeScript.",
  "scripts": {
    "clean:allure": "node -e \"require('node:fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "pretest:local": "npm run clean:allure",
    "test:local": "wdio run ./wdio.local.conf.ts",
    "pretest:browserstack": "npm run clean:allure",
    "test:browserstack": "wdio run ./wdio.browserstack.conf.ts",
    "appium": "appium",
    "appium:doctor": "appium driver doctor uiautomator2",
    "appium:drivers": "appium driver list --installed",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.2",
    "@wdio/allure-reporter": "^9.27.2",
    "@wdio/appium-service": "^9.27.2",
    "@wdio/browserstack-service": "^9.27.2",
    "@wdio/cli": "^9.27.2",
    "@wdio/globals": "^9.27.2",
    "@wdio/local-runner": "^9.27.2",
    "@wdio/mocha-framework": "^9.27.2",
    "@wdio/spec-reporter": "^9.27.2",
    "allure-commandline": "^2.35.1",
    "appium": "^3.5.0",
    "appium-uiautomator2-driver": "^7.6.1",
    "expect-webdriverio": "^5.6.8",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "@browserstack/ai-sdk-node": {
      "uuid": "11.1.1"
    }
  }
}
