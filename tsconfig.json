{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "mocha",
      "@wdio/globals/types",
      "expect-webdriverio"
    ]
  },
  "include": [
    "wdio.*.conf.ts",
    "test/**/*.ts"
  ]
}
